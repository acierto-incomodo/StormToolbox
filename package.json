    "productName": "StormToolbox",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TU_USUARIO",
        "repo": "stormtoolbox"
      }
    ]
  }
