{
  "name": "stormtoolbox",
  "version": "1.0.0",
  "description": "StormToolbox - gestor de sistema",
  "main": "main.js",
  "author": "Aitor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
