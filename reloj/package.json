{
  "name": "reloj",
  "version": "1.0.0",
  "description": "StormToolbox - Reloj",
  "main": "main.js",
  "author": "Aitor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.stormgamesstudios.stormtoolbox.reloj",
    "productName": "StormToolbox - Reloj",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "acierto-incomodo",
        "repo": "stormtoolbox"
      }
    ]
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11"
  }
}
